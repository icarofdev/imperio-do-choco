APP_ENV=development
APP_URL=http://localhost/imperio-do-choco
APP_TIMEZONE=America/Sao_Paulo
SESSION_DRIVER=files
SESSION_LIFETIME=7200

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=imperio_do_choco
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Producao (MySQL remoto com TLS)
# SESSION_DRIVER=database
# DB_SSL_CA=C:\caminho\absoluto\ca.pem
# Na Vercel, prefira o certificado CA em base64, sem quebras de linha:
# DB_SSL_CA_BASE64=

# Recuperacao de senha por email
# Use "log" em desenvolvimento, "brevo" para API da Brevo ou "smtp" para Gmail/Brevo/SendGrid SMTP.
EMAIL_PROVIDER=log
EMAIL_FROM=contato@velledulcis.com
EMAIL_FROM_NAME="Velle Dulcis"

# Brevo API
# BREVO_API_KEY=sua-chave-brevo-aqui

# SMTP generico
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ENCRYPTION=tls

# SMS de pedido
# SMS_ENABLED=true
# SMS_TO=+5511999999999
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_API_URL=
# SMS_API_TOKEN=
# SMS_API_KEY=
